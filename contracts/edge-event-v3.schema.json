{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/team-between/gapguard/contracts/edge-event-v3.schema.json",
  "title": "GAPGUARD Edge Event V3",
  "description": "Non-periodic Edge events generated by lifecycle, thresholds, connectivity, or sensor failures.",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "siteId": { "type": "string", "minLength": 1 },
        "sectionId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "sourceType": { "type": "string", "enum": ["physical", "simulator"] },
        "measuredAt": { "type": "string", "format": "date-time" },
        "seqNo": { "type": "integer", "minimum": 0 },
        "dataHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eventId": { "type": "string", "pattern": "^[^:]+:[^:]+:[0-9]+$" },
        "streamId": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "const": 3 },
        "producedAt": { "type": "string", "format": "date-time" },
        "testRunId": { "type": "string", "minLength": 1 },
        "eventType": {
          "type": "string",
          "enum": [
            "DEVICE_STARTED", "DEVICE_STOPPED", "CALIBRATION_COMPLETED", "CALIBRATION_FAILED",
            "THRESHOLD_EXCEEDED", "CONNECTION_LOST", "CONNECTION_RECOVERED",
            "LOCAL_BUFFERING_STARTED", "LOCAL_BUFFERING_STOPPED", "RETRANSMISSION_STARTED",
            "RETRANSMISSION_COMPLETED", "RETRANSMISSION_FAILED", "SENSOR_ERROR"
          ]
        },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "DANGER", "ERROR"] },
        "reason": { "type": "string", "minLength": 1 },
        "details": { "type": "object", "additionalProperties": true }
      },
      "required": [
        "siteId", "sectionId", "deviceId", "sourceType", "measuredAt", "seqNo",
        "dataHash", "eventId", "streamId", "schemaVersion", "producedAt", "testRunId",
        "eventType", "severity", "reason", "details"
      ],
      "unevaluatedProperties": false
    }
  ]
}
